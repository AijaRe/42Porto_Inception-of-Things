Vagrant.configure("2") do |config|
  config.vm.box = "debian/bookworm64"
  config.vm.define "arepsaS" do |server|
    server.vm.hostname = "arepsaS"
    server.vm.network "private_network", ip: "192.168.56.110"
    server.vm.provider "virtualbox" do |vb|
      vb.name   = "arepsaS"
      vb.cpus   = 1
      vb.memory = 1024
    end
	# Install k3s
    server.vm.provision "ServerSetup", type: "shell", path: "scripts/server_setup.sh"
	# Deploy apps after k3s is ready
	server.vm.provision "DeployApps", type: "shell", path: "scripts/deploy_apps.sh"
  end
end
